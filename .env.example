# STAMAS — Master Environment Configuration Template
# Copy this file to .env and customize values for your deployment

# Environment & Server Settings
ENV=development                  # Options: development, demo, production
PORT=8000
HOST=0.0.0.0
STAMAS_VERSION=1.0.0

# Database Configuration
# SQLite (Local Development): sqlite:///./stamas.db
# PostgreSQL (Production Docker): postgresql://stamas_user:stamas_pass@db:5432/stamas_db
DATABASE_URL=sqlite:///./stamas.db

# File Storage Configuration
UPLOAD_DIR=./storage/uploads
PROCESSED_DIR=./storage/processed
REPORT_DIR=./storage/reports
TEMP_DIR=./storage/temp
SAMPLE_DATA_DIR=./data/sample_tenders
MAX_UPLOAD_SIZE=104857600       # Maximum upload size in bytes (100 MB)

# CORS & Network Configuration
# Comma-separated list of allowed origin URLs
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Frontend Configuration (used by Vite frontend)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# AI & RAG Intelligence Provider Configuration
# AI_PROVIDER Options: GEMINI, OPENAI, LOCAL, NONE
# EMBEDDING_PROVIDER Options: KEYWORD, GEMINI, OPENAI, LOCAL
AI_PROVIDER=GEMINI
EMBEDDING_PROVIDER=KEYWORD
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Logging
LOG_LEVEL=INFO                  # Options: DEBUG, INFO, WARNING, ERROR
